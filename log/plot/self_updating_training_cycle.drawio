        </mxCell>
        <mxCell id="posroutes" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#25834B;fontColor=#172B3A;fontSize=16;spacing=12;arcSize=12;strokeWidth=2;" value="&lt;b&gt;Positive construction routes&lt;/b&gt;&lt;br&gt;Sample routes; encourage demonstrated / equivalent actions" vertex="1">
