        </mxCell>
        <mxCell id="train" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#172B3A;fontSize=16;spacing=12;arcSize=12;strokeWidth=2;" value="&lt;b&gt;Train / fine-tune the GNN&lt;/b&gt;&lt;br&gt;Positive loss + λ × negative loss&lt;br&gt;&lt;br&gt;Stage I: positive only&lt;br&gt;Stage IV: continue existing weights" vertex="1">
          <mxGeometry height="155" width="255" x="675" y="335" as="geometry" />
        </mxCell>
        <mxCell id="model" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#172B3A;fontSize=16;spacing=12;arcSize=12;strokeWidth=2;" value="&lt;b&gt;Selected GNN policy&lt;/b&gt;&lt;br&gt;Evaluate against parent;&lt;br&gt;retain parent if criteria fail" vertex="1">
