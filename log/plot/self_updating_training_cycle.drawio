  <diagram id="reference-guided-cycle" name="Training cycle">
    <mxGraphModel dx="2054" dy="1150" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1000" math="0" shadow="0">
