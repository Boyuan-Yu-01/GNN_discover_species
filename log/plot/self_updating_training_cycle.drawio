        </mxCell>
        <mxCell id="negroutes" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#B83C3C;fontColor=#172B3A;fontSize=16;spacing=12;arcSize=12;strokeWidth=2;" value="&lt;b&gt;Negative construction routes&lt;/b&gt;&lt;br&gt;Sample species and routes;&lt;br&gt;penalize complete rejected routes" vertex="1">
