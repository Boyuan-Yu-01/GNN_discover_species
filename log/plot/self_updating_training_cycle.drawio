        <mxCell id="addpositive" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#25834B;fontColor=#172B3A;fontSize=16;spacing=12;arcSize=12;strokeWidth=2;" value="&lt;b&gt;Update positive dataset&lt;/b&gt;&lt;br&gt;Add new reference matches; deduplicate.&lt;br&gt;Keep previous positives; recovered known graphs add no duplicates." vertex="1">
