        </mxCell>
        <mxCell id="addnegative" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#B83C3C;fontColor=#172B3A;fontSize=16;spacing=12;arcSize=12;strokeWidth=2;" value="&lt;b&gt;Prepare next-round negative dataset&lt;/b&gt;&lt;br&gt;Deduplicate unmatched structures.&lt;br&gt;Remove overlaps with the positive set." vertex="1">
          <mxGeometry height="115" width="470" x="900" y="680" as="geometry" />
        </mxCell>
        <mxCell id="note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#172B3A;fontSize=16;spacing=12;arcSize=12;strokeWidth=2;align=left;fontSize=15;" value="&lt;b&gt;Interpretation and current implementation&lt;/b&gt;&lt;br&gt;Reference absence is not proof of chemical invalidity. Matching checks graph structure, not experimental stability or resolved electronic states.&lt;br&gt;Generation uses frozen weights (Stages II / V). Updates occur only during training. The network is not using PPO.&lt;br&gt;Stage VI currently classifies both methods separately. The dashed feedback paths describe next-round dataset preparation; merging both outputs and launching another round are not yet automated." vertex="1">
